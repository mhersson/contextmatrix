{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "size": "size-limit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "size-limit": [
    {
      "name": "Entry chunk (loaded on every page)",
      "path": "dist/assets/index-*.js",
      "limit": "100 kB"
    },
    {
      "name": "ProjectShell chunk (main app shell, critical path)",
      "path": "dist/assets/ProjectShell-*.js",
      "limit": "45 kB"
    },
    {
      "name": "Markdown pipeline chunk (lazy, fetched on first markdown render)",
      "path": "dist/assets/safeMarkdownOptions-*.js",
      "limit": "150 kB"
    },
    {
      "name": "md-editor chunk (lazy, fetched on first editor open)",
      "path": "dist/assets/SafeMDEditor-*.js",
      "limit": "70 kB"
    }
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@uiw/react-markdown-preview": "^5.2.1",
    "@uiw/react-md-editor": "^4.1.6",
    "diff": "^9.0.0",
    "property-information": "7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0",
    "react-router": "^8.5.1",
    "rehype-attr": "4.0.2",
    "rehype-ignore": "2.0.3",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^14.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "size-limit": "^14.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  }
}
